<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#E8F5E9">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Details"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#5D4037"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/edit_text_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Item Name (e.g., Milk)"
        android:inputType="textCapWords"
        android:textColor="#5D4037"
        android:textColorHint="#795548"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edit_text_quantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Quantity (e.g., 2)"
        android:inputType="numberDecimal"
        android:textColor="#5D4037"
        android:textColorHint="#795548"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edit_text_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Unit (e.g., Liters, Pack, Kg)"
        android:inputType="text"
        android:textColor="#5D4037"
        android:textColorHint="#795548"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/edit_text_expiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="Expiry Date (e.g., 2026-12-31)"
        android:inputType="date"
        android:textColor="#5D4037"
        android:textColorHint="#795548" />

</LinearLayout>